[Unit]
Description=LAN Terminal (borderless terminal controlled over the LAN)
PartOf=graphical-session.target
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/lan-terminal
ExecStart=/opt/lan-terminal/node_modules/.bin/electron --ozone-platform=x11 /opt/lan-terminal
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
