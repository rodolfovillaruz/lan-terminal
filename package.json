{
  "name": "lan-terminal",
  "version": "1.0.0",
  "description": "Borderless multi-window terminal controlled over the LAN",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron --ozone-platform=x11 .",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild -f -w node-pty"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^44.7.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
